PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Optional: override the database name in the URI
# MONGODB_DB=portfolio

# Admin auth — generate the hash with: npm run hash-password -- yourPasswordHere
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=


# Long random string — used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" once the site is served over HTTPS in production
SESSION_SECURE_COOKIE=false

# Cloudinary uploads — create credentials in your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
